{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "invoices",
  "version": "0.4.0",
  "identifier": "com.lan-solo.invoices",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "invoices",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwNTkzQUVDNEM0NjcyMjUKUldRbGNrWk03RHBaTU4wV2E4WmF4ZXcvMkJ3ZGhvNTN0d3RwcVljK2hSeFY3RDFoZmZhWU83bkYK",
      "endpoints": [
        "https://github.com/LAN-SOLO/invoices/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Rechnungstool für kleine Unternehmen: Kunden, Artikel, Rechnungen, PDF",
    "longDescription": "invoices verwaltet Kunden und Artikel, schreibt Rechnungen und Gutschriften mit korrekter Umsatzsteuer (inkl. Kleinunternehmerregelung §19), exportiert PDFs mit eigenem Briefkopf und behält offene Posten im Blick. Alles lokal.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
